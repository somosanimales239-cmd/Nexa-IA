{
  "manifest_version": 3,
  "name": "Nexa AI Browser Bridge",
  "version": "1.1.0",
  "description": "Conecta Chrome con Nexa AI, guarda conocimiento local y ejecuta investigaciones web automáticas para Auto Knowledge Factory.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:32145/*",
    "http://localhost:32145/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nexa AI Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
